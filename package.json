{
  "name": "mydeck-firebase-rules-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-mydeck-kotlin \"node --test firebase-tests/rules.test.mjs\"",
    "seed:plan": "node scripts/seed-real-mydeck.mjs",
    "seed:real": "node scripts/seed-real-mydeck.mjs --apply --project mydeck-kotlin --confirm REAL-mydeck-kotlin",
    "test:seed": "node --check scripts/seed-real-mydeck.mjs && node scripts/seed-real-mydeck.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^14.0.0",
    "firebase-admin": "^13.0.0"
  }
}
