rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isOwner(userId) { return signedIn() && uid() == userId; }
    function isAdmin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && get(/databases/$(database)/documents/users/$(uid())).data.role == role;
    }
    function isStudent() { return hasRole('student'); }
    function isTeacher() { return hasRole('teacher'); }
    function isClassOwner(classId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == uid();
    }
    function isEnrolled(classId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        exists(/databases/$(database)/documents/enrollments/$(classId + '_' + uid())) &&
        get(/databases/$(database)/documents/enrollments/$(classId + '_' + uid())).data.studentId == uid();
    }
    function isDeckOwner(deckId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/decks/$(deckId)) &&
        get(/databases/$(database)/documents/decks/$(deckId)).data.ownerUid == uid();
    }
    function isDeckOwnerAfter(deckId) {
      return signedIn() &&
        getAfter(/databases/$(database)/documents/decks/$(deckId)).data.ownerUid == uid();
    }
    // O aluno recebe acesso após comprovar matrícula + atribuição ativa.
    // Remover a atribuição invalida os acessos já emitidos.
    function hasActiveDeckAccess(deckId) {
      let accessPath = /databases/$(database)/documents/deckAccess/$(deckId + '_' + uid());
      return signedIn() &&
        exists(accessPath) &&
        get(accessPath).data.studentId == uid() &&
        get(accessPath).data.deckId == deckId &&
        isEnrolled(get(accessPath).data.classId) &&
        exists(/databases/$(database)/documents/classDeckAssignments/$(get(accessPath).data.classId + '_' + deckId));
    }
    function canReadDeck(deckId) { return isDeckOwner(deckId) || hasActiveDeckAccess(deckId); }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'username', 'role', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['student', 'pending_teacher']
        && request.resource.data.name is string
        && request.resource.data.username is string;
      allow update, delete: if isAdmin();
    }
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
        request.resource.data.uid == uid() &&
        getAfter(/databases/$(database)/documents/users/$(uid())).data.username == username;
      allow update, delete: if isAdmin();
    }
    match /classes/{classId} {
      allow get, list: if signedIn() &&
        (resource.data.ownerUid == uid() || isEnrolled(classId));
      allow create: if isTeacher() &&
        request.resource.data.keys().hasOnly(['name', 'ownerUid', 'joinCode', 'createdAt']) &&
        request.resource.data.ownerUid == uid() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.joinCode is string &&
        request.resource.data.joinCode.matches('^[A-Z2-9]{8}$') &&
        getAfter(/databases/$(database)/documents/classCodes/$(request.resource.data.joinCode)).data.classId == classId;
      allow update: if isTeacher() && resource.data.ownerUid == uid() &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.joinCode == resource.data.joinCode &&
        request.resource.data.keys().hasOnly(['name', 'ownerUid', 'joinCode', 'createdAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0;
      allow delete: if isTeacher() && resource.data.ownerUid == uid();
    }
    match /classCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isTeacher() &&
        request.resource.data.keys().hasOnly(['classId', 'ownerUid', 'createdAt']) &&
        request.resource.data.ownerUid == uid() &&
        request.resource.data.classId is string &&
        code.matches('^[A-Z2-9]{8}$') &&
        getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.ownerUid == uid() &&
        getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.joinCode == code;
      allow update: if false;
      allow delete: if isTeacher() && resource.data.ownerUid == uid();
    }
    match /enrollments/{enrollmentId} {
      allow get, list: if signedIn() &&
        (resource.data.studentId == uid() || isClassOwner(resource.data.classId));
      allow create: if isStudent() &&
        request.resource.data.keys().hasOnly(['classId', 'studentId', 'username', 'joinCode', 'joinedAt']) &&
        request.resource.data.studentId == uid() &&
        request.resource.data.classId is string &&
        request.resource.data.joinCode is string &&
        request.resource.data.username == get(/databases/$(database)/documents/users/$(uid())).data.username &&
        enrollmentId == request.resource.data.classId + '_' + uid() &&
        exists(/databases/$(database)/documents/classes/$(request.resource.data.classId)) &&
        get(/databases/$(database)/documents/classCodes/$(request.resource.data.joinCode)).data.classId == request.resource.data.classId;
      allow update: if false;
      allow delete: if signedIn() &&
        (resource.data.studentId == uid() || isClassOwner(resource.data.classId));
    }

    // Biblioteca canônica do professor; alunos nunca enumeram a biblioteca.
    match /decks/{deckId} {
      allow get: if canReadDeck(deckId);
      allow list: if signedIn() && resource.data.ownerUid == uid();
      allow create: if isTeacher() &&
        request.resource.data.keys().hasOnly(['ownerUid', 'title', 'assignedClassIds', 'createdAt']) &&
        request.resource.data.ownerUid == uid() &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.assignedClassIds is list &&
        request.resource.data.assignedClassIds.size() <= 40;
      allow update: if isTeacher() && resource.data.ownerUid == uid() &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.keys().hasOnly(['ownerUid', 'title', 'assignedClassIds', 'createdAt']) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.assignedClassIds is list &&
        request.resource.data.assignedClassIds.size() <= 40;
      allow delete: if isTeacher() && resource.data.ownerUid == uid();

      match /cards/{cardId} {
        allow get, list: if canReadDeck(deckId);
        allow create, update: if isTeacher() && isDeckOwner(deckId) &&
          request.resource.data.keys().hasOnly([
            'type', 'question', 'answer', 'description', 'tags',
            'options', 'correctOptionIndex', 'frontLanguage', 'backLanguage',
            'mediaType', 'mediaUrl', 'createdAt'
          ]) &&
          request.resource.data.question is string &&
          request.resource.data.question.size() > 0 &&
          request.resource.data.answer is string &&
          request.resource.data.tags is list &&
          request.resource.data.tags.size() <= 20 &&
          request.resource.data.type in ['BASIC', 'MULTIPLE_CHOICE', 'CLOZE', 'REVERSIBLE', 'OPEN_ENDED'];
        allow delete: if isTeacher() && isDeckOwner(deckId);
      }
    }

    // Alunos descobrem os IDs de decks atribuídos às suas turmas.
    // Nenhuma atribuição é suficiente sem matrícula ativa.
    match /classDeckAssignments/{assignmentId} {
      allow get, list: if signedIn() &&
        (isClassOwner(resource.data.classId) || isEnrolled(resource.data.classId));
      allow create: if isTeacher() &&
        request.resource.data.keys().hasOnly(['classId', 'deckId', 'ownerUid']) &&
        request.resource.data.ownerUid == uid() &&
        request.resource.data.classId is string &&
        request.resource.data.deckId is string &&
        assignmentId == request.resource.data.classId + '_' + request.resource.data.deckId &&
        isClassOwner(request.resource.data.classId) &&
        isDeckOwnerAfter(request.resource.data.deckId);
      allow update: if false;
      allow delete: if isTeacher() && resource.data.ownerUid == uid() &&
        isClassOwner(resource.data.classId) && isDeckOwner(resource.data.deckId);
    }

    // Grant emitido pelo próprio aluno após checar matrícula + atribuição.
    // A regra de leitura do deck revalida ambos mesmo após revogação.
    match /deckAccess/{accessId} {
      allow get: if signedIn() && resource.data.studentId == uid();
      allow list: if false;
      allow create, update: if isStudent() &&
        request.resource.data.keys().hasOnly(['deckId', 'studentId', 'classId']) &&
        request.resource.data.studentId == uid() &&
        request.resource.data.deckId is string &&
        request.resource.data.classId is string &&
        accessId == request.resource.data.deckId + '_' + uid() &&
        isEnrolled(request.resource.data.classId) &&
        exists(/databases/$(database)/documents/classDeckAssignments/$(request.resource.data.classId + '_' + request.resource.data.deckId));
      allow delete: if signedIn() && resource.data.studentId == uid();
    }

    match /reviews/{reviewId} {
      allow get, list: if signedIn() &&
        (resource.data.studentId == uid() || resource.data.ownerUid == uid());
      allow create: if isStudent() &&
        request.resource.data.keys().hasOnly([
          'studentId', 'ownerUid', 'deckId', 'cardId', 'classId', 'correct',
          'writtenResponse', 'tags', 'reviewedAtEpochMillis',
          'dueAtEpochMillis', 'intervalDays', 'repetitions'
        ]) &&
        request.resource.data.studentId == uid() &&
        request.resource.data.deckId is string &&
        request.resource.data.cardId is string &&
        request.resource.data.ownerUid ==
          get(/databases/$(database)/documents/decks/$(request.resource.data.deckId)).data.ownerUid &&
        request.resource.data.classId is string &&
        isEnrolled(request.resource.data.classId) &&
        exists(/databases/$(database)/documents/classDeckAssignments/$(request.resource.data.classId + '_' + request.resource.data.deckId)) &&
        hasActiveDeckAccess(request.resource.data.deckId) &&
        exists(/databases/$(database)/documents/decks/$(request.resource.data.deckId)/cards/$(request.resource.data.cardId)) &&
        request.resource.data.reviewedAtEpochMillis is number &&
        request.resource.data.dueAtEpochMillis is number &&
        request.resource.data.tags is list;
      allow update: if isStudent() &&
        resource.data.studentId == uid() &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.deckId == resource.data.deckId &&
        request.resource.data.cardId == resource.data.cardId &&
        request.resource.data.classId == resource.data.classId &&
        hasActiveDeckAccess(resource.data.deckId);
      allow delete: if false;
    }
  }
}
